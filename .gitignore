# --- Build output ---
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/
packages/

# Built plugin artifact — produced by `dotnet build`, not vendored.
GameData/RP-AXE/Plugins/*.dll
GameData/RP-AXE/Plugins/*.pdb

# NOTE: GameData/RP-AXE/seed/ (vendored RP-1 config) IS committed — the mod ships self-contained.
# Refresh it with tools/sync-seed.ps1; never hand-edit it (changes go in design/).

# --- OS / editor cruft ---
Thumbs.db
desktop.ini
.DS_Store
dist/

# Python cache
__pycache__/

# Repo-root scratch / analysis working files (no tool consumes them)
/scratch_*
/scratchpad_*

# KSP-generated part icon thumbnails (written into the vendored seed at runtime)
@thumbs/

# Per-save launcher generated by tools/save_progress.py (mirrors YOUR save, not shared state)
tree/render/prototype/save-view.html

# Written by the plugin on first run if absent (see AxeBridge.LoadConfig).
GameData/RP-AXE/Plugins/PluginData/Bridge.cfg
