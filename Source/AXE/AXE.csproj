<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RP-AXE minimal plugin: a ContractConfigurator extension + a lightweight program ScenarioModule.
    NOT a reimplementation of RP-1's career engine (no KCT/maintenance/tooling/avionics/crew).
    Build:  $env:KSPRoot = "C:\git\ksp\Instance"; dotnet build Source/AXE/AXE.csproj -c Release
    Output AXE.dll is copied into GameData/RP-AXE/Plugins/ by the post-build target below.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AXE</AssemblyName>
    <RootNamespace>RPAxe</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <!-- KSP ships its own copies; never copy framework/engine DLLs to output. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!--
      Kerbalism 3.41 is built against net481. MSBuild's default reaction to referencing a HIGHER framework
      than the target is to DROP the reference (MSB3274) and let the compile fail with CS0246s that read
      like a missing using. Retargeting AXE to net481 is not the fix: KSP runs Unity's Mono against the
      4.8 profile, and 4.8.1 adds no API this uses. Everything AXE touches in Kerbalism exists in 4.8.
    -->
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ReferencePath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ReferencePath)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ReferencePath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ReferencePath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ReferencePath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(ReferencePath)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ReferencePath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ReferencePath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ReferencePath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ContractConfigurator">
      <HintPath>$(KSPRoot)\GameData\ContractConfigurator\ContractConfigurator.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RealFuels">
      <HintPath>$(KSPRoot)\GameData\RealFuels\Plugins\RealFuels.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ModularFlightIntegrator">
      <HintPath>$(KSPRoot)\GameData\ModularFlightIntegrator\ModularFlightIntegrator.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      Kerbalism shipped its assembly as Kerbalism112.kbin (a renamed DLL that KerbalismBootstrap loads,
      which is why AssemblyLoader can never see it) through 3.1x; 3.41 ships a plain Kerbalism.dll and no
      .kbin at all. Reference whichever the instance actually has, or a Kerbalism update silently breaks
      the build with six CS0246s that read like a missing using.
    -->
    <Reference Include="Kerbalism">
      <HintPath Condition="Exists('$(KSPRoot)\GameData\Kerbalism\Kerbalism.dll')">$(KSPRoot)\GameData\Kerbalism\Kerbalism.dll</HintPath>
      <HintPath Condition="!Exists('$(KSPRoot)\GameData\Kerbalism\Kerbalism.dll')">$(KSPRoot)\GameData\Kerbalism\Kerbalism112.kbin</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ReferencePath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ReferencePath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ReferencePath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(KSPRoot)\GameData\000_Harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Drop the built DLL straight into the shipping GameData folder. -->
  <Target Name="CopyToGameData" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\..\GameData\RP-AXE\Plugins" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(MSBuildProjectDirectory)\..\..\GameData\RP-AXE\Plugins" />
  </Target>

</Project>
