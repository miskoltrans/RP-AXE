{
    "spec_version": "v1.18",
    "identifier": "RP-AXE",
    "name": "RP-AXE: Ahistorical Xploration & Engineering",
    "abstract": "RP-1's realism stack with a lightweight, science-driven, exploration-first career replacing the RP-1 career plugin. Parts unlock free with science; engineering and exploration are the focus, not management.",
    "author": [ "__GITHUB_OWNER__" ],
    "license": "CC-BY-NC-SA-4.0",

    "$kref": "#/ckan/github/__GITHUB_OWNER__/RP-AXE",

    "ksp_version_min": "1.12.0",
    "ksp_version_max": "1.12.5",

    "tags": [ "config", "career", "total-conversion", "career-scaling", "physics" ],

    "comment": "RP-AXE = RP-1's dependency set MINUS the RP-1 career plugin, PLUS the future-part packs it places in the tree. CKAN auto-resolves transitive deps (Kopernicus, RealHeat, FAR, AJE, B9PartSwitch, CommunityResourcePack, ROLib's deps, etc.), so they are not listed here. Tantares identifiers are NewTantares/NewTantaresLV.",

